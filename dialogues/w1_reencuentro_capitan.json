[
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "No pensé que volvería a verte aquí.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Yo tampoco pensaba volver.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Entonces ya te enteraste.",
    "expression": "sad"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Sé que está muerta.",
    "expression": "sad"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "¿Y por eso has regresado con la espada en la mano?",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Regresé porque le hice una promesa a su padre.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Protegerla.",
    "expression": "sad"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Y fallé.",
    "expression": "sad"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Tú no estabas aquí.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "La Reina sí.",
    "expression": "anger"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Ella permitió que la llevaran al ritual.",
    "expression": "anger"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Eso es lo que todos dicen.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "¿Estás diciendo que es mentira?",
    "expression": "anger"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Estoy diciendo que desde aquella noche nadie cuenta la historia completa.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "El rey desapareció.",
    "expression": "fear",
    "camera_cue": "cementery"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Los caminos fueron cerrados.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Los soldados empezaron a atacar incluso a los suyos.",
    "expression": "fear"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Y cada noche aparecen cosas que antes solo existían en cuentos.",
    "expression": "fear"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "No he venido por monstruos.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Lo sé.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Voy a encontrar a la Reina.",
    "expression": "anger"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Entonces hazme un favor.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "¿Cuál?",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Busca respuestas antes de decidir a quién debes matar.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Ya sé quién es responsable.",
    "expression": "anger"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Eso mismo pensábamos todos.",
    "expression": "sad"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Hasta que empezamos a encontrar los cuerpos.",
    "expression": "fear",
    "pause_before": 0.5
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "¿Qué cuerpos?",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Sigue el camino hacia el reino. Lo entenderás pronto.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Hablas como si supieras algo.",
    "expression": "neutral"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Sé lo suficiente para tener miedo.",
    "expression": "fear"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Ten cuidado, viejo amigo.",
    "expression": "sad"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Este reino ya no distingue entre héroes y cadáveres.",
    "expression": "fear"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Pero no voy a permitir que sigas adelante.",
    "expression": "neutral"
  },
  {
    "speaker_id": "player",
    "name": "GUERRERO",
    "text": "Entonces no me dejas otra elección.",
    "expression": "anger"
  },
  {
    "speaker_id": "friend",
    "name": "CAPITÁN",
    "text": "Ojalá la hubiera.",
    "expression": "sad"
  }
]
